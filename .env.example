# Copy to .env and fill in your values. Never commit the real .env.
# Loaded automatically in development and test via dotenv-rails.

# --- Server ---
# Puma reads PORT (default 3000; the original design listened on 8200).
PORT=8200
# SQLite database file path (absolute or relative to the app root).
DATABASE_PATH=storage/production.sqlite3

# --- Master key ---
# 32 bytes as 64 hexadecimal characters. Generate with: bin/rails vault:generate_key
# Keep it out of the database's backups: the two together decrypt everything.
VAULT_MASTER_KEY=
